<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ISKCON KHETURI DHAM"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donation Management"
            android:textSize="18sp"
            android:gravity="center"
            android:paddingBottom="20dp"/>

        <TextView
            android:id="@+id/tvPending"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pending synchronization: 0"
            android:textStyle="bold"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnDonation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💰 Donation"/>

        <Button
            android:id="@+id/btnPromised"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤝 Promised Donation"/>

        <Button
            android:id="@+id/btnDonations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Donations"/>

        <Button
            android:id="@+id/btnPromisedList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📜 Promised Donations"/>

    </LinearLayout>

</ScrollView>
